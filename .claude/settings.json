{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run images:check)",
      "Bash(npm run check:og)",
      "Bash(npm --prefix blog run build)",
      "Bash(npm --prefix blog run images:check)",
      "Bash(npm --prefix blog run check:og)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./blog/node_modules/**)",
      "Read(./blog/dist/**)",
      "Read(./blog/.astro/**)",
      "Read(./blog/package-lock.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
