---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/content';
---

<BaseLayout title="Página não encontrada">
  <div class="py-20 text-center">
    <p class="font-serif text-6xl font-extrabold text-ink">404</p>
    <h1 class="mt-4 text-xl font-semibold text-ink">Esta página não existe.</h1>
    <a href={url('/')} class="mt-6 inline-block text-sm font-semibold text-accent hover:underline">
      ← voltar para a página inicial
    </a>
  </div>
</BaseLayout>
