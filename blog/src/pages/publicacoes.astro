---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories, getPostsByCategory, getPostUrl, getPublishedPosts, url } from '../lib/content';

const total = (await getPublishedPosts()).length;
const groups = await Promise.all(
  (await getCategories()).map(async (category) => ({ ...category, posts: await getPostsByCategory(category.slug) })),
);
const formatter = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Todas as publicações" description="Arquivo completo do DevOpsOne, organizado por editoria.">
  <header class="mb-10">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1 border-b-2 border-ink pb-3">
      <h1 class="font-sans text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Publicações</h1>
      <p class="pb-1.5 text-sm text-muted">{total} publicaç{total === 1 ? 'ão' : 'ões'}</p>
    </div>
    <nav aria-label="Ir para a editoria" class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm font-semibold">
      {groups.map((group) => (
        <a href={`#${group.slug}`} class="text-accent hover:underline">{group.name}</a>
      ))}
    </nav>
  </header>

  <div class="grid gap-y-12">
    {groups.map((group) => (
      <section id={group.slug} class="scroll-mt-24">
        <h2 class="rule-double flex items-baseline justify-between pt-3 font-sans text-sm font-bold uppercase tracking-widest text-ink">
          <a href={url(`/categorias/${group.slug}/`)} class="hover:text-accent">{group.name}</a>
          <span class="font-normal normal-case tracking-normal text-muted">{group.count}</span>
        </h2>
        <ul class="mt-2">
          {group.posts.map((post) => (
            <li>
              <a href={getPostUrl(post)} class="group flex items-baseline justify-between gap-4 border-b border-rule py-3">
                <span class="font-sans font-semibold leading-snug text-ink group-hover:text-accent">{post.data.title}</span>
                {post.data.date && (
                  <time datetime={post.data.date.toISOString()} class="shrink-0 text-xs text-muted">{formatter.format(post.data.date)}</time>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
