---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedSection from '../components/FeaturedSection.astro';
import { getPublishedPosts, getCategories, url } from '../lib/content';

const posts = await getPublishedPosts();
const categories = await getCategories();
const [headline, ...rest] = posts;
const secondary = rest.slice(0, 3);
const moreNews = rest.slice(3, 11);
---

<BaseLayout title="Início">
  {headline ? (
    <FeaturedSection headline={headline} secondary={secondary} />
  ) : (
    <p class="border-b border-rule pb-10 text-muted">
      Nenhuma página ainda. Adicione arquivos <code class="text-accent">.md</code> em
      <code class="text-accent"> src/content/posts/&lt;categoria&gt;/</code>.
    </p>
  )}

  <div class="grid gap-12 lg:grid-cols-3">
    {moreNews.length > 0 && (
      <section class="lg:col-span-2">
        <h2 class="rule-double mb-6 pt-3 font-serif text-sm font-bold uppercase tracking-widest text-ink">Mais publicações</h2>
        <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {moreNews.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    )}

    {categories.length > 0 && (
      <aside>
        <h2 class="rule-double mb-4 pt-3 font-serif text-sm font-bold uppercase tracking-widest text-ink">Editorias</h2>
        <ul>
          {categories.map((category) => (
            <li>
              <a
                href={url(`/categorias/${category.slug}/`)}
                class="flex items-baseline justify-between border-b border-rule py-3 font-serif text-lg font-semibold text-ink hover:text-accent"
              >
                {category.name}
                <span class="font-sans text-sm font-normal text-muted">{category.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>
