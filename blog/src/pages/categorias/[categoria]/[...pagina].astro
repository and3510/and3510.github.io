---
import CoverImage from '../../../components/CoverImage.astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CategoryBadge from '../../../components/CategoryBadge.astro';
import PostLinks from '../../../components/PostLinks.astro';
import { getPublishedPosts, getCategorySlug, getPostSlug, getReadingTime, formatCategoryName, resolvePostRefs, url } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: {
      categoria: getCategorySlug(post),
      pagina: getPostSlug(post),
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const prerequisites = await resolvePostRefs(post, 'prerequisites');
const related = await resolvePostRefs(post, 'related');
const categorySlug = getCategorySlug(post);
const categoryName = formatCategoryName(categorySlug);
const formatter = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
const dateLabel = post.data.date ? formatter.format(post.data.date) : null;
const updatedLabel =
  post.data.updatedDate && post.data.date && post.data.updatedDate.getTime() !== post.data.date.getTime()
    ? formatter.format(post.data.updatedDate)
    : null;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-[44rem]">
    <header class="mb-10 border-b border-rule pb-8 text-center">
      <CategoryBadge slug={categorySlug} name={categoryName} size="md" />
      <h1 class="mt-4 font-serif text-4xl font-extrabold leading-tight text-ink sm:text-5xl">{post.data.title}</h1>
      {post.data.description && (
        <p class="mx-auto mt-5 max-w-2xl font-serif text-xl italic leading-relaxed text-muted">{post.data.description}</p>
      )}
      <p class="mt-6 text-sm text-muted">
        {dateLabel && <span>Publicado em {dateLabel}</span>}
        {updatedLabel && <span> · Atualizado em {updatedLabel}</span>}
        <span> · {getReadingTime(post)} min de leitura</span>
      </p>
    </header>
    {post.data.cover && (
      <figure class="-mx-4 mb-10 sm:mx-0">
        <CoverImage
          src={post.data.cover}
          alt={post.data.coverAlt ?? ''}
          widths={[800, 1400]}
          sizes="(min-width: 768px) 704px, 100vw"
          loading="eager"
          class="w-full object-cover sm:rounded-md"
        />
        {post.data.coverAlt && (
          <figcaption class="mt-2 px-4 text-center text-sm italic text-muted sm:px-0">{post.data.coverAlt}</figcaption>
        )}
      </figure>
    )}
    <div class="mb-8">
      <PostLinks title="Antes de ler" posts={prerequisites} />
    </div>
    <div class="prose-post">
      <Content />
    </div>
    <div class="mt-12">
      <PostLinks title="Veja também" posts={related} />
    </div>
    <footer class="rule-double mt-16 pt-6">
      <a href={url(`/categorias/${categorySlug}/`)} class="text-sm font-semibold text-accent hover:underline">
        ← Mais de {categoryName}
      </a>
    </footer>
  </article>
</BaseLayout>
