---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories } from '../../lib/content';

const categories = await getCategories();
---

<BaseLayout title="Editorias">
  <h1 class="mb-6 border-b border-neutral-200 pb-4 font-serif text-3xl font-extrabold text-neutral-900">Editorias</h1>
  {categories.length > 0 ? (
    <div class="grid gap-4 sm:grid-cols-2">
      {categories.map((category) => (
        <a
          href={`/categorias/${category.slug}/`}
          class="flex items-center justify-between border-b border-neutral-200 py-4 hover:text-red-700"
        >
          <span class="font-serif text-lg font-bold text-neutral-900">{category.name}</span>
          <span class="text-sm text-neutral-400">{category.count} página{category.count === 1 ? '' : 's'}</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-neutral-500">Nenhuma categoria ainda.</p>
  )}
</BaseLayout>
