---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, url } from '../../lib/content';

const categories = await getCategories();
---

<BaseLayout title="Editorias">
  <h1 class="mb-6 border-b border-rule pb-4 font-sans tracking-tight text-3xl font-extrabold text-ink">Editorias</h1>
  {categories.length > 0 ? (
    <div class="grid gap-4 sm:grid-cols-2">
      {categories.map((category) => (
        <a
          href={url(`/categorias/${category.slug}/`)}
          class="flex items-center justify-between border-b border-rule py-4 hover:text-accent"
        >
          <span class="font-sans text-lg font-bold text-ink">{category.name}</span>
          <span class="text-sm text-muted">{category.count} página{category.count === 1 ? '' : 's'}</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-muted">Nenhuma categoria ainda.</p>
  )}
</BaseLayout>
