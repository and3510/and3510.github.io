---
import { getPostUrl, type Post } from '../lib/content';

interface Props {
  title: string;
  posts: Post[];
}

const { title, posts } = Astro.props;
---

{posts.length > 0 && (
  <aside class="post-links">
    <h2>{title}</h2>
    <ul>
      {posts.map((p) => (
        <li><a href={getPostUrl(p)}>{p.data.title}</a></li>
      ))}
    </ul>
  </aside>
)}
