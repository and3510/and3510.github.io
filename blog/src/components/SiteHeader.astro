---
import SearchBox from './SearchBox.astro';
import { url } from '../lib/content';

interface Props {
  categories: { slug: string; name: string; count: number }[];
  siteTitle: string;
}

const { categories, siteTitle } = Astro.props;
const currentPath = Astro.url.pathname;
const today = new Intl.DateTimeFormat('pt-BR', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' }).format(new Date());
const linkClass = 'shrink-0 border-b-2 py-3 text-sm font-semibold transition';
---

<header>
  <div class="mx-auto w-full max-w-6xl px-4 pt-6 sm:px-6">
    <div class="flex items-center justify-between text-xs text-muted">
      <span class="capitalize">{today}</span>
      <button
        type="button"
        id="theme-toggle"
        class="inline-flex items-center gap-1.5 rounded border border-rule px-2 py-1 font-semibold text-muted transition hover:border-accent hover:text-accent"
        aria-label="Alternar tema claro/escuro"
        title="Alternar tema claro/escuro"
      >
        <svg class="h-3.5 w-3.5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="hidden h-3.5 w-3.5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <span class="dark:hidden">Escuro</span>
        <span class="hidden dark:inline">Claro</span>
      </button>
    </div>
    <a href={url('/')} class="block pb-2 pt-4 text-center font-sans text-5xl font-extrabold tracking-tight text-ink sm:text-6xl">
      {siteTitle}
    </a>
    <p class="pb-5 text-center font-sans text-base text-muted">
      DevOps, Cloud e SRE: cultura e infraestrutura para escalar
    </p>
  </div>
  {categories.length > 0 && (
    <nav class="rule-double sticky top-0 z-20 border-b border-rule bg-paper/95 backdrop-blur">
      <div class="mx-auto flex w-full max-w-6xl flex-col-reverse gap-x-6 px-4 sm:flex-row sm:items-center sm:px-6">
        <div class="flex flex-1 gap-6 overflow-x-auto">
          <a
            href={url('/')}
            class:list={[linkClass, currentPath === url('/') ? 'border-accent text-accent' : 'border-transparent text-ink hover:text-accent']}
          >
            Início
          </a>
          {categories.map((category) => (
            <a
              href={url(`/categorias/${category.slug}/`)}
              class:list={[
                linkClass,
                currentPath.startsWith(url(`/categorias/${category.slug}/`))
                  ? 'border-accent text-accent'
                  : 'border-transparent text-ink hover:text-accent',
              ]}
            >
              {category.name}
            </a>
          ))}
        </div>
        <div class="pt-3 sm:py-2 sm:pt-2">
          <SearchBox />
        </div>
      </div>
    </nav>
  )}
</header>

<script>
  // Alterna claro/escuro. Se a escolha bater com o tema do sistema, apaga a preferência
  // salva para o site voltar a seguir o sistema automaticamente.
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    try {
      if (next === system) localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {}
    document.documentElement.dataset.theme = next;
  });
</script>
