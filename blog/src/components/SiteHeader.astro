---
import SearchBox from './SearchBox.astro';
import { url } from '../lib/content';

interface Props {
  categories: { slug: string; name: string; count: number }[];
  siteTitle: string;
}

const { categories, siteTitle } = Astro.props;
const currentPath = Astro.url.pathname;
const linkClass = 'shrink-0 border-b-2 py-4 text-base font-semibold transition';

// Faixas de comandos que passam ao fundo do topo (só decoração).
const commands = [
  // Kubernetes
  'kubectl rollout status deploy/api',
  'kubectl get pods -A -o wide',
  'kubectl describe pod api-7d9f8b6c5-x2k4q',
  'kubectl logs -f deploy/api --since=10m',
  'kubectl scale deploy/api --replicas=5',
  'kubectl rollout undo deploy/api',
  'helm upgrade --install blog ./chart -f values.yaml',
  'argocd app sync devopsone',
  // Docker
  'docker build -t devopsone:latest .',
  'docker compose up -d --build',
  'docker image prune -f',
  // CI/CD e Git
  'git push origin main',
  'git tag -a v1.4.0 -m "release"',
  'gh workflow run pages.yml',
  // Cloud e IaC
  'terraform plan -out=tfplan',
  'terraform apply tfplan',
  'ansible-playbook site.yml --check',
  'aws s3 sync ./dist s3://devopsone',
  // Linux e Redes
  'systemctl status nginx',
  'journalctl -u nginx -f',
  'chmod 640 /etc/app/config.yaml',
  'ss -tulpn | grep 443',
  'dig +short and3510.github.io',
  'curl -I https://and3510.github.io/blog/',
  'ssh -J bastion deploy@10.0.1.12',
  'traceroute 8.8.8.8',
];
// Cada faixa pega um comando a cada três, para não repetir a mesma sequência.
const bands = [0, 1, 2].map((offset) => commands.filter((_, i) => i % 3 === offset));
---

<header>
  <div class="relative overflow-hidden">
  <div class="cmd-bands" aria-hidden="true">
    {bands.map((row, i) => (
      <div class:list={['cmd-band', { reverse: i === 1 }]}>
        <div class="cmd-track">
          {[...row, ...row].map((cmd) => <span>$ {cmd}</span>)}
        </div>
      </div>
    ))}
  </div>
  <div class="relative mx-auto w-full max-w-6xl px-4 pt-6 sm:px-6">
    <a href={url('/')} class="block pb-2 pt-4 text-center font-sans text-5xl font-extrabold tracking-tight text-ink sm:text-6xl">
      {siteTitle}
    </a>
    <p class="pb-5 text-center font-sans text-base text-muted">
      DevOps, Cloud e SRE: cultura e infraestrutura para escalar
    </p>
  </div>
  </div>
  {categories.length > 0 && (
    <nav class="rule-double sticky top-0 z-20 border-b border-rule bg-paper/95 backdrop-blur">
      <div class="mx-auto flex w-full max-w-6xl flex-col-reverse gap-x-6 px-4 sm:flex-row sm:items-center sm:px-6">
        <div class="flex flex-1 gap-6 overflow-x-auto pr-8 [mask-image:linear-gradient(90deg,#000_80%,transparent)] sm:pr-0 sm:[mask-image:none]">
          <a
            href={url('/')}
            class:list={[linkClass, currentPath === url('/') ? 'border-accent text-accent' : 'border-transparent text-ink hover:text-accent']}
          >
            Início
          </a>
          {categories.map((category) => (
            <a
              href={url(`/categorias/${category.slug}/`)}
              class:list={[
                linkClass,
                currentPath.startsWith(url(`/categorias/${category.slug}/`))
                  ? 'border-accent text-accent'
                  : 'border-transparent text-ink hover:text-accent',
              ]}
            >
              {category.name}
            </a>
          ))}
        </div>
        <div class="flex items-center gap-3 pt-3 sm:py-2 sm:pt-2">
          <div class="min-w-0 flex-1 sm:flex-none">
            <SearchBox />
          </div>
          <button
            type="button"
            id="theme-toggle"
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-muted transition hover:bg-accent-soft hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
            aria-label="Alternar tema claro/escuro"
            title="Alternar tema"
          >
            <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
          </button>
        </div>
      </div>
    </nav>
  )}
</header>

<script>
  // Alterna claro/escuro. Se a escolha bater com o tema do sistema, apaga a preferência
  // salva para o site voltar a seguir o sistema automaticamente.
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    try {
      if (next === system) localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {}
    document.documentElement.dataset.theme = next;
  });
</script>

<style>
  .cmd-bands {
    position: absolute;
    inset: 0.75rem 0 0.75rem;
    display: grid;
    align-content: center;
    gap: 0.6rem;
    pointer-events: none;
    /* Bordas esmaecidas + uma elipse vazia atrás do nome e da frase, para não brigar com o texto. */
    -webkit-mask-image:
      radial-gradient(ellipse 30rem 4.5rem at 50% 50%, transparent 70%, #000 100%),
      linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(ellipse 30rem 4.5rem at 50% 50%, transparent 70%, #000 100%),
      linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-composite: intersect;
  }
  @media (max-width: 640px) {
    /* No celular o nome ocupa quase toda a largura: as faixas ficam só como textura bem leve. */
    .cmd-band {
      opacity: 0.12;
    }
  }
  .cmd-band {
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
    opacity: 0.3;
  }
  .cmd-track {
    display: flex;
    width: max-content;
    animation: cmd-slide 120s linear infinite;
  }
  .cmd-band.reverse .cmd-track {
    animation-direction: reverse;
    animation-duration: 150s;
  }
  .cmd-track span {
    padding-right: 2.2rem;
  }
  @keyframes cmd-slide {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cmd-track {
      animation: none;
    }
  }
</style>
