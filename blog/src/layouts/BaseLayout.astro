---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getCategories, url } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /** Imagem do card de compartilhamento (LinkedIn etc.). Sem ela, usa /og-default.jpg. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = 'Notas de estudo, projetos e prática de DevOps e infraestrutura.',
  image,
  imageAlt,
  type = 'website',
  publishedTime,
} = Astro.props;
const siteTitle = 'DevOpsOne';
const categories = await getCategories();

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// 1200x627 em JPG: tamanho recomendado pelo LinkedIn (WebP não é exibido de forma confiável).
let ogImage = new URL(url('/og-default.jpg'), Astro.site).href;
let ogImageSize: { width: number; height: number } | null = { width: 1200, height: 627 };
if (typeof image === 'string') {
  ogImage = image;
  ogImageSize = null;
} else if (image) {
  const card = await getImage({ src: image, width: 1200, height: 627, fit: 'cover', format: 'jpg' });
  ogImage = new URL(card.src, Astro.site).href;
}
const ogTitle = title === 'Início' ? siteTitle : title;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
    {ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
    <meta property="og:image:alt" content={imageAlt ?? ogTitle} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="author" content="Anderson do Vale" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;0,8..60,800;1,8..60,400&family=JetBrains+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · {siteTitle}</title>
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <SiteHeader categories={categories} siteTitle={siteTitle} />
    <main class="mx-auto w-full max-w-6xl px-4 pb-20 pt-10 sm:px-6">
      <slot />
    </main>
    <footer class="rule-double mx-auto max-w-6xl py-8 text-center text-sm text-muted">
      <p>{siteTitle} · conteúdo em Markdown.</p>
    </footer>
  </body>
</html>
