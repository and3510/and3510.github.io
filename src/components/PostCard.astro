---
import CategoryBadge from './CategoryBadge.astro';
import { getCategorySlug, getPostSlug, formatCategoryName, type Post } from '../lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const categorySlug = getCategorySlug(post);
const categoryName = formatCategoryName(categorySlug);
const postSlug = getPostSlug(post);
const dateLabel = post.data.date
  ? new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(post.data.date)
  : null;
---

<article class="group relative border-b border-neutral-200 pb-6">
  <div class="mb-2 flex items-center gap-3">
    <CategoryBadge slug={categorySlug} name={categoryName} />
    {dateLabel && <span class="text-xs text-neutral-400">{dateLabel}</span>}
  </div>
  <h3 class="font-serif text-xl font-bold leading-snug text-neutral-900 group-hover:text-red-700">
    <a href={`/categorias/${categorySlug}/${postSlug}/`} class="after:absolute after:inset-0">
      {post.data.title}
    </a>
  </h3>
  {post.data.description && <p class="mt-2 text-sm leading-relaxed text-neutral-600">{post.data.description}</p>}
</article>
