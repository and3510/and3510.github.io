---
interface Props {
  categories: { slug: string; name: string; count: number }[];
  siteTitle: string;
}

const { categories, siteTitle } = Astro.props;
const currentPath = Astro.url.pathname;
const today = new Intl.DateTimeFormat('pt-BR', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' }).format(new Date());
---

<header class="border-b border-neutral-900">
  <div class="mx-auto w-full max-w-5xl px-4 py-3 sm:px-6">
    <p class="hidden text-xs capitalize text-neutral-400 sm:block">{today}</p>
    <a href="/" class="block py-3 text-center font-serif text-4xl font-extrabold tracking-tight text-neutral-900 sm:text-5xl">
      {siteTitle}
    </a>
    <p class="pb-3 text-center text-sm italic text-neutral-500">
      DevOps, Cloud e SRE: cultura e infraestrutura para escalar
    </p>
  </div>
  {categories.length > 0 && (
    <nav class="border-t border-neutral-900 bg-neutral-900">
      <div class="mx-auto flex w-full max-w-5xl flex-wrap justify-center gap-x-6 gap-y-1 px-4 py-2.5 sm:px-6">
        <a
          href="/"
          class:list={[
            'text-sm font-semibold uppercase tracking-wide text-white transition hover:text-red-400',
            currentPath === '/' && 'text-red-400',
          ]}
        >
          Início
        </a>
        {categories.map((category) => (
          <a
            href={`/categorias/${category.slug}/`}
            class:list={[
              'text-sm font-semibold uppercase tracking-wide text-neutral-300 transition hover:text-red-400',
              currentPath.startsWith(`/categorias/${category.slug}`) && 'text-red-400',
            ]}
          >
            {category.name}
          </a>
        ))}
      </div>
    </nav>
  )}
</header>
