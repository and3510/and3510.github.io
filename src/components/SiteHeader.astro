---
import SearchBox from './SearchBox.astro';

interface Props {
  categories: { slug: string; name: string; count: number }[];
  siteTitle: string;
}

const { categories, siteTitle } = Astro.props;
const currentPath = Astro.url.pathname;
const today = new Intl.DateTimeFormat('pt-BR', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' }).format(new Date());
const linkClass = 'shrink-0 border-b-2 py-3 text-sm font-semibold transition';
---

<header>
  <div class="mx-auto w-full max-w-6xl px-4 pt-6 sm:px-6">
    <div class="flex items-center justify-between text-xs text-muted">
      <span class="capitalize">{today}</span>
      <span class="hidden sm:inline">Edição online</span>
    </div>
    <a href="/" class="block pb-2 pt-4 text-center font-serif text-5xl font-extrabold tracking-tight text-ink sm:text-6xl">
      {siteTitle}
    </a>
    <p class="pb-5 text-center font-serif text-base italic text-muted">
      DevOps, Cloud e SRE: cultura e infraestrutura para escalar
    </p>
  </div>
  {categories.length > 0 && (
    <nav class="rule-double sticky top-0 z-20 border-b border-rule bg-paper/95 backdrop-blur">
      <div class="mx-auto flex w-full max-w-6xl flex-col-reverse gap-x-6 px-4 sm:flex-row sm:items-center sm:px-6">
        <div class="flex flex-1 gap-6 overflow-x-auto">
          <a
            href="/"
            class:list={[linkClass, currentPath === '/' ? 'border-accent text-accent' : 'border-transparent text-ink hover:text-accent']}
          >
            Início
          </a>
          {categories.map((category) => (
            <a
              href={`/categorias/${category.slug}/`}
              class:list={[
                linkClass,
                currentPath.startsWith(`/categorias/${category.slug}/`)
                  ? 'border-accent text-accent'
                  : 'border-transparent text-ink hover:text-accent',
              ]}
            >
              {category.name}
            </a>
          ))}
        </div>
        <div class="pt-3 sm:py-2 sm:pt-2">
          <SearchBox />
        </div>
      </div>
    </nav>
  )}
</header>
