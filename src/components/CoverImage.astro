---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { src, alt, widths, sizes, loading = 'lazy', class: className } = Astro.props;
---

{typeof src === 'string' ? (
  <img src={src} alt={alt} loading={loading} decoding="async" referrerpolicy="no-referrer" class={className} />
) : (
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} class={className} />
)}
