---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import { getPublishedPosts, getCategories, getPostSlug, formatCategoryName, getCategorySlug } from '../lib/content';

const posts = await getPublishedPosts();
const categories = await getCategories();
const [headline, ...rest] = posts;
const secondary = rest.slice(0, 2);
const moreNews = rest.slice(2, 8);
---

<BaseLayout title="Início">
  {headline ? (
    <section class="mb-10 grid gap-8 border-b border-neutral-200 pb-10 lg:grid-cols-3">
      <article class="relative lg:col-span-2">
        <div class="mb-3 flex items-center gap-3">
          <CategoryBadge slug={getCategorySlug(headline)} name={formatCategoryName(getCategorySlug(headline))} size="md" />
        </div>
        <h1 class="font-serif text-3xl font-extrabold leading-tight text-neutral-900 sm:text-4xl">
          <a href={`/categorias/${getCategorySlug(headline)}/${getPostSlug(headline)}/`} class="after:absolute after:inset-0 hover:underline">
            {headline.data.title}
          </a>
        </h1>
        {headline.data.description && (
          <p class="mt-4 text-lg leading-relaxed text-neutral-600">{headline.data.description}</p>
        )}
      </article>
      <div class="flex flex-col gap-6 lg:border-l lg:border-neutral-200 lg:pl-8">
        {secondary.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  ) : (
    <p class="border-b border-neutral-200 pb-10 text-neutral-500">
      Nenhuma página ainda. Adicione arquivos <code class="text-red-600">.md</code> em
      <code class="text-red-600"> src/content/posts/&lt;categoria&gt;/</code>.
    </p>
  )}

  {categories.length > 0 && (
    <section class="mb-10 border-b border-neutral-200 pb-10">
      <h2 class="mb-4 font-serif text-sm font-bold uppercase tracking-widest text-neutral-500">Editorias</h2>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        {categories.map((category) => (
          <a href={`/categorias/${category.slug}/`} class="text-sm font-semibold text-neutral-800 hover:text-red-700">
            {category.name} <span class="text-neutral-400">({category.count})</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {moreNews.length > 0 && (
    <section>
      <h2 class="mb-4 font-serif text-sm font-bold uppercase tracking-widest text-neutral-500">Mais publicações</h2>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {moreNews.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}
</BaseLayout>
