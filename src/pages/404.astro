---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada">
  <div class="py-20 text-center">
    <p class="font-serif text-6xl font-extrabold text-neutral-900">404</p>
    <h1 class="mt-4 text-xl font-semibold text-neutral-700">Esta página não existe.</h1>
    <a href="/" class="mt-6 inline-block text-sm font-semibold text-red-600 hover:text-red-700">
      ← voltar para a página inicial
    </a>
  </div>
</BaseLayout>
